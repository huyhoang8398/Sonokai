{
  "name": "Sonokai Shusia",
  "author": "sainnhe (palette), ported to Sublime Text 4",
  "variables": {
    "black": "#1a181a",
    "bg_dim": "#211f21",
    "bg0": "#2d2a2e",
    "bg1": "#37343a",
    "bg2": "#3b383e",
    "bg3": "#423f46",
    "bg4": "#49464e",
    "bg_red": "#55393d",
    "bg_yellow": "#4e432f",
    "bg_green": "#394634",
    "bg_blue": "#354157",
    "bg_purple": "#433d51",
    "filled_red": "#ff6188",
    "filled_green": "#a9dc76",
    "filled_blue": "#78dce8",
    "fg": "#e3e1e4",
    "red": "#f85e84",
    "orange": "#ef9062",
    "yellow": "#e5c463",
    "green": "#9ecd6f",
    "blue": "#7accd7",
    "purple": "#ab9df2",
    "grey": "#848089",
    "grey_dim": "#605d68"
  },
  "globals": {
    "background": "var(bg0)",
    "foreground": "var(fg)",
    "caret": "var(fg)",
    "line_highlight": "var(bg1)",
    "selection": "var(bg3)",
    "selection_border": "var(bg3)",
    "misspelling": "var(red)",
    "accent": "var(blue)",
    "find_highlight": "var(yellow)",
    "find_highlight_foreground": "var(bg0)",
    "highlight": "var(bg_green)",
    "highlight_foreground": "var(green)",
    "gutter": "var(bg0)",
    "gutter_foreground": "var(grey_dim)",
    "line_diff_added": "var(green)",
    "line_diff_modified": "var(yellow)",
    "line_diff_deleted": "var(red)",
    "guide": "var(bg3)",
    "active_guide": "var(grey_dim)",
    "stack_guide": "var(bg3)",
    "brackets_foreground": "var(fg)",
    "brackets_background": "var(bg4)",
    "brackets_options": "underline",
    "bracket_contents_foreground": "var(fg)",
    "bracket_contents_options": "underline",
    "tags_foreground": "var(red)",
    "tags_options": "underline",
    "shadow": "#00000040",
    "minimap_border": "var(bg_dim)",
    "block_caret": "var(fg)"
  },
  "rules": [
    {
      "scope": "comment, punctuation.definition.comment",
      "foreground": "var(grey)",
      "font_style": "italic"
    },
    {
      "scope": "string, punctuation.definition.string",
      "foreground": "var(yellow)"
    },
    {
      "scope": "constant.numeric, constant.language, constant.character, constant.other.placeholder, support.constant",
      "foreground": "var(purple)"
    },
    {
      "scope": "constant",
      "foreground": "var(orange)"
    },
    {
      "scope": "keyword, keyword.operator, storage, storage.modifier, meta.preprocessor, entity.name.function.preprocessor",
      "foreground": "var(red)"
    },
    {
      "scope": "storage.type",
      "foreground": "var(blue)"
    },
    {
      "scope": "storage.type.function, storage.type.class, storage.type.struct, storage.type.enum, storage.type.import",
      "foreground": "var(red)"
    },
    {
      "scope": "keyword.other.unit",
      "foreground": "var(purple)"
    },
    {
      "scope": "entity.name.function, support.function, meta.function-call variable.function, variable.function",
      "foreground": "var(green)"
    },
    {
      "scope": "entity.name.class, entity.name.type, entity.name.struct, entity.name.enum, entity.name.interface, entity.other.inherited-class, support.class, support.type, meta.generic",
      "foreground": "var(blue)"
    },
    {
      "scope": "variable.parameter, variable.language",
      "foreground": "var(orange)"
    },
    {
      "scope": "variable, meta.path",
      "foreground": "var(fg)"
    },
    {
      "scope": "punctuation, meta.brace, meta.block",
      "foreground": "var(fg)"
    },
    {
      "scope": "punctuation.separator, punctuation.terminator, punctuation.accessor",
      "foreground": "var(grey)"
    },
    {
      "scope": "entity.name.tag, punctuation.definition.tag",
      "foreground": "var(red)"
    },
    {
      "scope": "entity.other.attribute-name",
      "foreground": "var(green)"
    },
    {
      "scope": "entity.name.label, entity.name.namespace, entity.name.module",
      "foreground": "var(purple)"
    },
    {
      "scope": "variable.annotation, meta.annotation, meta.decorator, entity.name.function.decorator",
      "foreground": "var(purple)"
    },
    {
      "scope": "constant.character.escape, string.regexp, constant.other.character-class",
      "foreground": "var(purple)"
    },
    {
      "scope": "support.type.property-name, meta.mapping.key string, entity.name.tag.yaml",
      "foreground": "var(blue)"
    },
    {
      "scope": "invalid",
      "foreground": "var(red)",
      "font_style": "underline"
    },
    {
      "scope": "markup.heading, entity.name.section",
      "foreground": "var(red)",
      "font_style": "bold"
    },
    {
      "scope": "markup.bold",
      "font_style": "bold"
    },
    {
      "scope": "markup.italic",
      "font_style": "italic"
    },
    {
      "scope": "markup.underline.link, string.other.link",
      "foreground": "var(blue)",
      "font_style": "underline"
    },
    {
      "scope": "markup.raw, markup.inline.raw",
      "foreground": "var(yellow)"
    },
    {
      "scope": "markup.quote",
      "foreground": "var(grey)",
      "font_style": "italic"
    },
    {
      "scope": "markup.list punctuation.definition.list",
      "foreground": "var(red)"
    },
    {
      "scope": "markup.inserted",
      "foreground": "var(green)"
    },
    {
      "scope": "markup.deleted",
      "foreground": "var(red)"
    },
    {
      "scope": "markup.changed",
      "foreground": "var(yellow)"
    }
  ]
}